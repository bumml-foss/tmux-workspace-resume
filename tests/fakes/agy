#!/usr/bin/env bash
# Fake Antigravity CLI (agy): records its arguments, creates ~/.gemini/antigravity-cli/
# presence/<uuid>.lock, conversations/<uuid>.db and appends to history.jsonl, keeps the presence
# lockfile open across the exec (unless FAKE_NO_OPEN=1), and blocks as "agy-fake <script> <args>"
# so the arguments stay on its command line like the real CLI's. FAKE_NO_SESSION=1 skips all files.
set -euo pipefail
if [ "${FAKE_BLOCK:-0}" = 1 ]; then trap 'kill "$!" 2>/dev/null; exit 0' HUP TERM; while :; do sleep 3600 & wait "$!"; done; fi
: "${FAKE_LOG:?}"
printf '%s\n' "$@" > "$FAKE_LOG/agy.$$.args"
sid="" prev=""
for a in "$@"; do
	case $a in --conversation=*) sid=${a#--conversation=} ;; esac
	if [ "$prev" = --conversation ]; then sid=$a; fi
	prev=$a
done
if [ -z "$sid" ]; then sid=$(cat /proc/sys/kernel/random/uuid); fi
if [ "${FAKE_NO_SESSION:-0}" != 1 ]; then
	dir=${ANTIGRAVITY_CLI_HOME:-$HOME/.gemini/antigravity-cli}
	mkdir -p "$dir/presence" "$dir/conversations"
	: > "$dir/presence/$sid.lock"
	: > "$dir/conversations/$sid.db"
	ts=$(( $(date +%s) * 1000 ))
	jq -cn --arg display "fake prompt" --argjson ts "$ts" --arg ws "$PWD" --arg cid "$sid" \
		'{display: $display, timestamp: $ts, workspace: $ws, conversationId: $cid}' >> "$dir/history.jsonl"
	if [ "${FAKE_NO_OPEN:-0}" != 1 ]; then
		exec 3>>"$dir/presence/$sid.lock"     # held open across the exec below, like a live session
	fi
fi
export FAKE_BLOCK=1
exec -a agy-fake bash "$0" "$@"
