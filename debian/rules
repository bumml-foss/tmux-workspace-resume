#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_build:

override_dh_auto_test:

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/ai-revive PREFIX=/usr

# The units are per user; `ai-revive enable` turns them on for the user who wants them.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable
