#!/usr/bin/env bash
# ai-revive — save and restore a tmux/byobu workspace across reboots, including the programs
# that were running in each pane (Claude Code sessions by ID, ssh connections, ...).
#
# Copyright (C) 2026 Benedikt Humml <bumml.foss@proton.me>
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

# Locate the installation: a checkout / TPM clone (this file in <root>/bin) or a system install
# (/usr/bin/ai-revive -> /usr/share/ai-revive). AI_REVIVE_HOME overrides.
_self=$(readlink -f "${BASH_SOURCE[0]}")
_root=$(dirname "$(dirname "$_self")")
if [ -z "${AI_REVIVE_HOME:-}" ]; then
	if [ -e "$_root/ai-revive.tmux" ] && [ -d "$_root/lib" ]; then
		AI_REVIVE_HOME=$_root
	elif [ -d "$_root/share/ai-revive/lib" ]; then
		AI_REVIVE_HOME=$_root/share/ai-revive
	else
		echo "ai-revive: cannot find lib/ next to $_self (set AI_REVIVE_HOME)" >&2
		exit 1
	fi
fi
export AI_REVIVE_HOME
export AI_REVIVE_BIN=$_self

for _lib in "$AI_REVIVE_HOME"/lib/*.sh; do
	# shellcheck source=/dev/null
	. "$_lib"
done

# Every one of these exists in tmux 3.0+; kill-window/kill-session are covered by window-unlinked.
AI_REVIVE_HOOKS="after-new-window after-split-window after-kill-pane after-rename-window after-rename-session \
after-select-layout after-resize-pane window-unlinked window-linked client-detached"
AI_REVIVE_HOOK_INDEX=900

cmd_version() { cat "$AI_REVIVE_HOME/VERSION"; }

cmd_help() {
	cat <<'USAGE'
usage: ai-revive [-q] <command> [options]

  save [--debounce] [--force]   snapshot every session, window, pane and resumable program
  restore [--dry-run] [--layout-only] [--auto] [snapshot]
                                rebuild from a snapshot (default: the newest) and relaunch programs
  list                          snapshots on disk
  status                        what is enabled, hooks, timer, newest snapshot
  enable [--byobu|--tmux]       wire ai-revive into byobu (or ~/.tmux.conf) and start the save timer
  disable                       undo enable
  resumers [list|probe <pane>]  the programs ai-revive knows how to relaunch
  shutdown | reboot             save, then systemctl poweroff / reboot
  version | help

Global: -q/--quiet silences stderr (the log in $XDG_STATE_HOME/ai-revive/ai-revive.log stays on).
Snapshots live in $XDG_STATE_HOME/ai-revive/snapshots/. Config: $XDG_CONFIG_HOME/ai-revive/config.
Manual pages: ai-revive(1), ai-revive-resumers(7).
USAGE
}

# hook install|remove: tmux hooks + key bindings on the running server (done by ai-revive.tmux).
cmd_hook() {
	local sub=${1:-} h bin
	has_server || die "no tmux server"
	bin=$(shell_quote "$AI_REVIVE_BIN")
	case $sub in
		install)
			for h in $AI_REVIVE_HOOKS; do
				tmux_cmd set-hook -g "${h}[$AI_REVIVE_HOOK_INDEX]" "run-shell -b \"$bin save --debounce --quiet\""
			done
			tmux_cmd bind-key "$KEY_SAVE" run-shell "$bin save --quiet && tmux display-message 'ai-revive: saved' || tmux display-message 'ai-revive: save failed, see the log'"
			tmux_cmd bind-key "$KEY_RESTORE" run-shell -b "$bin restore --quiet"
			log_debug "hooks and key bindings installed"
			;;
		remove)
			for h in $AI_REVIVE_HOOKS; do
				tmux_cmd set-hook -gu "${h}[$AI_REVIVE_HOOK_INDEX]" 2>/dev/null || true
			done
			tmux_cmd unbind-key "$KEY_SAVE" 2>/dev/null || true
			tmux_cmd unbind-key "$KEY_RESTORE" 2>/dev/null || true
			log_debug "hooks and key bindings removed"
			;;
		*) die "usage: ai-revive hook install|remove" ;;
	esac
}

main() {
	local cmd=""
	while [ $# -gt 0 ]; do
		case $1 in
			-q|--quiet) quiet_on ;;
			-h|--help|help) cmd_help; return 0 ;;
			-V|--version|version) cmd_version; return 0 ;;
			-*) echo "ai-revive: unknown option $1" >&2; cmd_help >&2; return 2 ;;
			*) cmd=$1; shift; break ;;
		esac
		shift
	done
	config_load
	tmux_args_init
	state_init
	case $cmd in
		save|restore|list|status|enable|disable|resumers|shutdown|reboot|hook) "cmd_$cmd" "$@" ;;
		"") cmd_help >&2; return 2 ;;
		*) echo "ai-revive: unknown command '$cmd'" >&2; cmd_help >&2; return 2 ;;
	esac
}

main "$@"
