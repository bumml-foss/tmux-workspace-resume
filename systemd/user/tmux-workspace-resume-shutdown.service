# Best effort: the user manager stops this unit when the session ends, which usually happens
# before the tmux server is killed, but systemd does not guarantee that order. Use
# `tmux-workspace-resume reboot` / `tmux-workspace-resume shutdown` when the snapshot must be exact.
[Unit]
Description=tmux-workspace-resume: snapshot the tmux/byobu workspace at shutdown
Documentation=man:tmux-workspace-resume(1)
DefaultDependencies=no
Before=shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
ExecStop=/usr/bin/tmux-workspace-resume save --quiet
TimeoutStopSec=20

[Install]
WantedBy=default.target
